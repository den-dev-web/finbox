{
  "name": "finbox-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css && prettier --check .",
    "lint:js": "eslint $(git ls-files --cached --others --exclude-standard \"*.js\" \"*.mjs\")",
    "lint:css": "stylelint $(git ls-files --cached --others --exclude-standard \"*.css\")",
    "format": "prettier --write . && stylelint \"src/**/*.css\" --fix",
    "typecheck": "tsc -p jsconfig.json",
    "test:unit": "vitest run",
    "pw": "${CONTAINER_CLI:-podman} run --rm --network host --ipc host -e CI -v \"$PWD\":/work:z -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test",
    "test:e2e": "npm run pw -- --project=smoke --project=smoke-mobile --project=html --project=a11y-desktop --project=a11y-mobile",
    "test:visual": "npm run pw -- --project=\"visual-*\"",
    "test:visual:update": "npm run pw -- --project=\"visual-*\" --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-plugin-compat": "^7.0.2",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ]
}
